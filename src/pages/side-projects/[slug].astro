---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Topbar from "../../components/Topbar.astro";
import Contact from "../../components/sections/Contact.astro";
import Footer from "../../components/sections/Footer.astro";
import Icon from "../../components/Icon.astro";
import { getSideProjects, site, url } from "../../lib/site";

export async function getStaticPaths() {
  const projects = await getSideProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const p = project.data;
const { Content } = await render(project);
---
<Base title={`${p.title} | ${site.name}`} description={p.caption}>
  <Topbar />
  <main>
    <section class="project-hero">
      <div class="project-head">
        <a class="body muted side-back" href={url("/#side-projects")}>← Side projects</a>
        <h1 class="h1">{p.title}</h1>
        <p class="body balance side-caption">{p.caption}</p>
        <div class="project-meta">
          <div class="project-meta-col"><p class="body muted">Date</p><p class="body">{p.date}</p></div>
          {p.links.length > 0 && (
            <div class="project-meta-col">
              <p class="body muted">Links</p>
              <p class="body side-links">
                {p.links.map((l) => <a href={l.url} target="_blank" rel="noreferrer">{l.title} ↗</a>)}
              </p>
            </div>
          )}
        </div>
      </div>
      <div class="project-cover side-cover">
        <img class="side-cover-bg" src={url(p.image)} alt="" aria-hidden="true" />
        <img class="side-cover-img" src={url(p.image)} alt={p.alt} />
      </div>
      <article class="side-article project-md">
        <Content />
      </article>
    </section>
    {next && next.id !== project.id && (
      <section class="next-project">
        <a class="next-link" href={url(`/side-projects/${next.id}/`)} aria-label={`Next side project: ${next.data.title}`}>
          <span class="next-text">
            <span class="body">Next side project</span>
            <span class="h2">{next.data.title}</span>
          </span>
          <span class="round-btn" aria-hidden="true"><Icon name="arrow-up-right" size={24} /></span>
        </a>
      </section>
    )}
    <Contact />
  </main>
  <Footer />
</Base>
